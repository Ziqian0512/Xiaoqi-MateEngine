/* XQ: G57 V1 — custom properties live on .xq, the card/bubble root.
   Do not move them to :root: that root is the whole panel, not this card,
   and the variables would not match. Change a value here and every var() below follows. */

.xq {
    --xq-bg: rgba(18, 20, 26, 0.92);
    --xq-bg-soft: rgba(28, 31, 40, 0.92);
    --xq-bg-bubble: rgba(24, 27, 35, 0.94);
    --xq-fg: rgb(238, 242, 248);
    --xq-fg-dim: rgb(169, 178, 194);
    --xq-accent: rgb(127, 180, 255);
    --xq-accent-soft: rgba(127, 180, 255, 0.16);
    --xq-line: rgba(255, 255, 255, 0.10);
    --xq-btn: rgba(255, 255, 255, 0.06);
    --xq-btn-hover: rgba(255, 255, 255, 0.12);
    --xq-radius: 18px;
    --xq-radius-sm: 12px;
    --xq-pad: 16px;
    --xq-gap: 10px;
    --xq-font-title: 17px;
    --xq-font-body: 13px;
    --xq-font-dim: 11px;
    flex-direction: column;
    align-items: flex-start;
}

.xq-anim {
    opacity: 1;
    translate: 0px 0px;
    transition-property: opacity, translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

.xq-enter {
    opacity: 0;
    translate: 0px 8px;
}

.xq-card {
    flex-direction: column;
    background-color: var(--xq-bg);
    border-radius: var(--xq-radius);
    border-width: 1px;
    border-color: var(--xq-line);
    padding: var(--xq-pad);
    min-width: 280px;
    max-width: 340px;
}

.xq-card--soft {
    background-color: var(--xq-bg-soft);
}

.xq-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--xq-gap);
}

.xq-row--tight {
    margin-bottom: 4px;
}

.xq-title {
    font-size: var(--xq-font-title);
    color: var(--xq-fg);
    -unity-font-style: bold;
}

.xq-body {
    font-size: var(--xq-font-body);
    color: var(--xq-fg);
    white-space: normal;
}

.xq-dim {
    font-size: var(--xq-font-dim);
    color: var(--xq-fg-dim);
}

.xq-missing {
    color: var(--xq-fg-dim);
}

.xq-pill {
    padding: 3px 9px;
    border-radius: var(--xq-radius-sm);
    background-color: var(--xq-accent-soft);
    color: var(--xq-accent);
    font-size: var(--xq-font-dim);
}

.xq-sep {
    height: 1px;
    background-color: var(--xq-line);
    margin-top: var(--xq-gap);
    margin-bottom: var(--xq-gap);
}

.xq-btn {
    padding: 6px 12px;
    border-radius: var(--xq-radius-sm);
    background-color: var(--xq-btn);
    color: var(--xq-fg);
    font-size: var(--xq-font-body);
}

.xq-btn:hover {
    background-color: var(--xq-btn-hover);
}

.xq-btn--ghost {
    background-color: rgba(0, 0, 0, 0);
    color: var(--xq-fg-dim);
}

.xq-bubble {
    flex-direction: column;
    background-color: var(--xq-bg-bubble);
    border-radius: var(--xq-radius-sm);
    padding: var(--xq-gap) 14px;
    max-width: 300px;
}

.xq-bubble__tail {
    width: 14px;
    height: 8px;
    background-color: var(--xq-bg-bubble);
    border-radius: 2px;
    margin-left: 18px;
}
