/* 变量只写在三套主题 class 上，不用 :root。换主题 = 根上只换这一个 class。
   字号至少 15：面板缩放到 0.8 时仍有 12 物理像素。阴影用 Sprites/xq-shadow.png 九宫格。 */

.xq-theme-pink {
    --xq-accent: #FF8FB8;
    --xq-accent2: #FFB36B;
    --xq-accent-ink: #D6477F;
    --xq-ink: #3B2F55;
    --xq-ink-soft: rgba(59, 47, 85, 0.62);
    --xq-r-card: 22px;
    --xq-r-panel: 32px;
    --xq-r-pill: 999px;
}

.xq-theme-blue {
    --xq-accent: #5AA8FF;
    --xq-accent2: #6FD6D0;
    --xq-accent-ink: #2A6FC4;
    --xq-ink: #3B2F55;
    --xq-ink-soft: rgba(59, 47, 85, 0.62);
    --xq-r-card: 22px;
    --xq-r-panel: 32px;
    --xq-r-pill: 999px;
}

.xq-theme-violet {
    --xq-accent: #B184FF;
    --xq-accent2: #FF9EC7;
    --xq-accent-ink: #7B4FD0;
    --xq-ink: #3B2F55;
    --xq-ink-soft: rgba(59, 47, 85, 0.62);
    --xq-r-card: 22px;
    --xq-r-panel: 32px;
    --xq-r-pill: 999px;
}

.xq-root {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    -unity-font: url("Fonts/NotoSansSC-Medium.ttf");
    font-size: 16px;
    color: var(--xq-accent-ink, #D6477F);
}

.xq-sample {
    position: absolute;
    flex-direction: column;
    align-items: flex-start;
}

.xq-bubble {
    position: relative;
    margin-bottom: 10px;
    margin-left: 16px;
    margin-right: 16px;
}

.xq-row {
    flex-direction: row;
    align-items: center;
    margin-left: 16px;
}

.xq-pill {
    margin-right: 8px;
}

.xq-tail {
    position: absolute;
    width: 16px;
    height: 14px;
    left: -14px;
    top: 18px;
    background-color: rgba(0, 0, 0, 0);
}

.xq-tail.xq-point-right {
    left: auto;
    right: -14px;
}

.xq-body {
    background-color: rgba(255, 255, 255, 0.82);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.88);
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.xq-bubble .xq-body {
    border-radius: var(--xq-r-card, 22px);
    min-width: 96px;
    min-height: 48px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 18px;
    padding-right: 18px;
}

.xq-pill .xq-body {
    border-radius: var(--xq-r-pill, 999px);
    min-height: 36px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 18px;
    padding-right: 18px;
}

.xq-btn .xq-body {
    width: 64px;
    height: 64px;
    border-radius: 8px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
}

.xq-glass {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(255, 255, 255, 0.78);
}

.xq-glass-emph {
    background-color: rgba(255, 255, 255, 0.88);
}

.xq-hi {
    position: absolute;
    left: 12px;
    right: 12px;
    top: 0;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.7);
}

.xq-label {
    font-size: 16px;
    color: var(--xq-accent-ink, #D6477F);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.xq-glass,
.xq-hi,
.xq-label,
.xq-sample,
.xq-root,
.xq-bubble,
.xq-row,
.xq-pill,
.xq-btn {
    picking-mode: ignore;
}

.xq-body,
.xq-tail {
    picking-mode: position;
}

.xq-hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.xq-bubble-real {
    position: absolute;
    width: 236px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 16px;
    padding-right: 16px;
}

.xq-bubble-real .xq-body {
    border-radius: 20px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 16px;
    padding-right: 16px;
    min-width: 0;
    min-height: 0;
    align-items: flex-start;
}

.xq-bubble-real .xq-copy {
    font-size: 15px;
    color: var(--xq-ink, #3B2F55);
    white-space: normal;
    -unity-text-align: upper-left;
    max-height: 44px;
    overflow: hidden;
}

.xq-bubble-real.xq-open .xq-copy {
    max-height: 160px;
}

.xq-tail-down {
    position: absolute;
    width: 20px;
    height: 12px;
    right: 30px;
    bottom: -10px;
    background-color: rgba(0, 0, 0, 0);
}

.xq-cap {
    position: absolute;
    flex-direction: row;
    align-items: center;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 10px;
    padding-right: 16px;
    min-height: 46px;
}

.xq-cap .xq-body {
    flex-direction: row;
    align-items: center;
    border-radius: var(--xq-r-pill, 999px);
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 10px;
    padding-right: 16px;
    min-height: 46px;
    min-width: 0;
}

.xq-cap-col {
    flex-direction: column;
    margin-left: 8px;
}

.xq-cap-kicker {
    font-size: 15px;
    color: var(--xq-ink-soft, rgba(59, 47, 85, 0.62));
    -unity-text-align: middle-left;
}

.xq-cap-line {
    font-size: 15px;
    color: var(--xq-ink, #3B2F55);
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.xq-icon {
    width: 30px;
    height: 30px;
    border-radius: 999px;
    background-color: rgba(255, 255, 255, 0.88);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.xq-ring {
    position: absolute;
    width: 64px;
    height: 64px;
    align-items: center;
    justify-content: center;
}

.xq-ring .xq-body {
    width: 64px;
    height: 64px;
    border-radius: 999px;
    min-width: 0;
    min-height: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
}

.xq-ring-word {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--xq-ink, #3B2F55);
    -unity-text-align: middle-center;
}

.xq-shadow {
    position: absolute;
    left: -28px;
    right: -28px;
    top: -18px;
    bottom: -28px;
    background-image: url("Sprites/xq-shadow.png");
    -unity-slice-left: 100;
    -unity-slice-right: 100;
    -unity-slice-top: 100;
    -unity-slice-bottom: 100;
    -unity-slice-scale: 0.5;
    picking-mode: ignore;
}

.xq-cap,
.xq-bubble-real,
.xq-ring,
.xq-icon,
.xq-cap-col,
.xq-cap-kicker,
.xq-cap-line,
.xq-copy,
.xq-ring-word,
.xq-shadow {
    picking-mode: ignore;
}

.xq-bubble-real .xq-body,
.xq-tail-down {
    picking-mode: position;
}

.xq-gate {
    position: absolute;
    width: 40px;
    height: 40px;
}

.xq-gate .xq-body {
    width: 40px;
    height: 40px;
    min-width: 0;
    min-height: 0;
    border-radius: 14px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
}

.xq-gate-mark {
    position: absolute;
    left: 9px;
    right: 9px;
    top: 9px;
    bottom: 9px;
}

.xq-quiet {
    position: absolute;
    align-items: center;
    justify-content: center;
}

.xq-quiet-word,
.xq-quiet-shade {
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.xq-quiet-word {
    color: rgb(255, 255, 255);
}

.xq-quiet-shade {
    position: absolute;
    left: 0;
    top: 1px;
    color: rgba(90, 50, 120, 0.45);
}

.xq-ring-detail {
    position: absolute;
    font-size: 15px;
    color: var(--xq-ink, #3B2F55);
    background-color: rgba(255, 255, 255, 0.88);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.8);
    border-radius: var(--xq-r-pill, 999px);
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 10px;
    padding-right: 10px;
    white-space: nowrap;
}

.xq-entries {
    position: absolute;
    flex-direction: column;
    align-items: flex-end;
}

.xq-entry {
    margin-bottom: 6px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: var(--xq-r-pill, 999px);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.8);
    font-size: 15px;
    -unity-text-align: middle-center;
}

.xq-entry-on {
    background-color: var(--xq-accent, #FF8FB8);
    color: rgb(255, 255, 255);
    border-color: rgba(255, 255, 255, 0.9);
}

.xq-entry-off {
    background-color: rgba(255, 255, 255, 0.5);
    color: var(--xq-ink, #3B2F55);
    border-color: rgba(255, 255, 255, 0.8);
    picking-mode: position;
}

.xq-entry-soon {
    background-color: rgba(255, 255, 255, 0.35);
    color: rgba(59, 47, 85, 0.45);
    border-color: rgba(255, 255, 255, 0.55);
}

.xq-soon-tip {
    position: absolute;
    right: 100%;
    top: 0;
    margin-right: 8px;
    font-size: 15px;
    color: var(--xq-ink, #3B2F55);
    background-color: rgba(255, 255, 255, 0.88);
    border-radius: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    white-space: nowrap;
    display: none;
}

.xq-entry-soon:hover .xq-soon-tip,
.xq-soon-tip.xq-tip-on {
    display: flex;
}

.xq-gate .xq-body,
.xq-entry-on {
    picking-mode: position;
}

.xq-entry-soon {
    picking-mode: position;
}

.xq-today {
    position: absolute;
    width: 280px;
}

.xq-today .xq-body {
    width: 280px;
    border-radius: var(--xq-r-card, 22px);
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 16px;
    padding-right: 16px;
    align-items: stretch;
    justify-content: flex-start;
}

.xq-today-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--xq-ink, #3B2F55);
    -unity-text-align: upper-left;
    margin-bottom: 2px;
}

.xq-today-date {
    font-size: 15px;
    color: var(--xq-ink-soft, rgba(59, 47, 85, 0.62));
    -unity-text-align: upper-left;
    margin-bottom: 8px;
    white-space: nowrap;
}

.xq-today-empty {
    font-size: 15px;
    color: rgba(59, 47, 85, 0.45);
    -unity-text-align: upper-left;
    white-space: normal;
}

.xq-today-rows {
    flex-direction: column;
}

.xq-today-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 10px;
}

.xq-today-row.xq-past {
    opacity: 0.4;
}

.xq-today-row.xq-now {
    background-color: var(--xq-accent, #FF8FB8);
}

.xq-today-time {
    font-size: 15px;
    color: var(--xq-ink-soft, rgba(59, 47, 85, 0.62));
    width: 108px;
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.xq-today-name {
    font-size: 15px;
    color: var(--xq-ink, #3B2F55);
    flex-grow: 1;
    -unity-text-align: middle-left;
    white-space: normal;
}

.xq-today-row.xq-now .xq-today-time,
.xq-today-row.xq-now .xq-today-name {
    color: rgb(255, 255, 255);
}

.xq-today-next {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.88);
}

.xq-today-kicker {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--xq-accent-ink, #D6477F);
    margin-right: 8px;
    white-space: nowrap;
}

.xq-today-next-line {
    font-size: 15px;
    color: var(--xq-ink, #3B2F55);
    flex-grow: 1;
    white-space: normal;
}

/* ===== 玻璃右键菜单（XqGlassMenu） ===== */
.xq-menu2 {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.xq-mcard {
    position: absolute;
    width: 244px;
}

.xq-mcard2 {
    width: 224px;
}

.xq-mbg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: 22px;
    background-color: rgba(252, 246, 255, 0.95);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.9);
    border-right-color: rgba(255, 255, 255, 0.9);
    border-top-color: rgba(255, 255, 255, 0.9);
    border-bottom-color: rgba(255, 255, 255, 0.9);
    picking-mode: ignore;
}

.xq-mbox {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
}

.xq-mstat {
    flex-direction: row;
    align-items: center;
    height: 30px;
    padding-left: 8px;
    padding-right: 8px;
    margin-bottom: 6px;
    border-radius: 12px;
    picking-mode: position;
}

.xq-mstat:hover {
    background-color: rgba(255, 255, 255, 0.45);
}

.xq-mdot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: var(--xq-accent, #FF8FB8);
    margin-right: 8px;
}

.xq-mstat-text {
    font-size: 15px;
    color: var(--xq-ink-soft, rgba(59, 47, 85, 0.62));
    -unity-text-align: middle-left;
    flex-grow: 1;
    white-space: nowrap;
    overflow: hidden;
}

.xq-mstat-energy {
    font-size: 15px;
    color: var(--xq-accent-ink, #D6477F);
    -unity-text-align: middle-right;
    white-space: nowrap;
}

.xq-mseg {
    flex-direction: row;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 3px;
    padding-right: 3px;
    margin-bottom: 8px;
    border-radius: 999px;
    background-color: rgba(255, 255, 255, 0.4);
}

.xq-mseg-btn {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 30px;
    border-radius: 999px;
    picking-mode: position;
}

.xq-mseg-btn:hover {
    background-color: rgba(255, 255, 255, 0.5);
}

.xq-mseg-on,
.xq-mseg-on:hover {
    background-color: var(--xq-accent, #FF8FB8);
}

.xq-mseg-off {
    opacity: 0.45;
}

.xq-mseg-glyph {
    width: 14px;
    height: 14px;
    margin-right: 3px;
}

.xq-mseg-text {
    font-size: 15px;
    color: var(--xq-ink, #3B2F55);
    white-space: nowrap;
}

.xq-mseg-text-on {
    color: rgb(255, 255, 255);
}

.xq-mrow {
    flex-direction: row;
    align-items: center;
    height: 38px;
    padding-left: 8px;
    padding-right: 10px;
    border-radius: 14px;
    picking-mode: position;
}

.xq-mrow:hover,
.xq-mrow-open {
    background-color: rgba(255, 255, 255, 0.55);
}

.xq-mic {
    width: 26px;
    height: 26px;
    border-radius: 13px;
    background-color: var(--xq-accent, #FF8FB8);
    align-items: center;
    justify-content: center;
    margin-right: 10px;
}

.xq-mglyph {
    width: 16px;
    height: 16px;
}

.xq-mtext {
    font-size: 16px;
    color: var(--xq-ink, #3B2F55);
    -unity-text-align: middle-left;
    flex-grow: 1;
    white-space: nowrap;
}

.xq-mchev {
    width: 14px;
    height: 14px;
}

.xq-mrow-gray .xq-mic {
    background-color: rgba(59, 47, 85, 0.14);
}

.xq-mrow-gray .xq-mtext {
    color: rgba(59, 47, 85, 0.4);
}

.xq-mrow-gray:hover {
    background-color: rgba(255, 255, 255, 0);
}

.xq-mtag {
    font-size: 15px;
    color: rgba(59, 47, 85, 0.45);
    white-space: nowrap;
    -unity-text-align: middle-right;
}

.xq-msep {
    height: 1px;
    margin-top: 6px;
    margin-bottom: 6px;
    margin-left: 8px;
    margin-right: 8px;
    background-color: rgba(255, 255, 255, 0.6);
}

.xq-mrow-set {
    height: 32px;
}

.xq-mrow-set .xq-mic {
    background-color: rgba(255, 255, 255, 0);
}

.xq-mrow-set .xq-mtext {
    font-size: 15px;
    color: var(--xq-ink-soft, rgba(59, 47, 85, 0.62));
}

.xq-mchips {
    flex-direction: row;
    flex-wrap: wrap;
    padding-left: 36px;
    padding-right: 6px;
    padding-bottom: 6px;
}

.xq-mchip {
    font-size: 15px;
    color: var(--xq-ink, #3B2F55);
    background-color: rgba(255, 255, 255, 0.5);
    border-radius: 999px;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 11px;
    padding-right: 11px;
    margin-right: 6px;
    margin-bottom: 6px;
    picking-mode: position;
}

.xq-mchip:hover {
    background-color: var(--xq-accent, #FF8FB8);
    color: rgb(255, 255, 255);
}

.xq-mchip-stop {
    color: var(--xq-accent-ink, #D6477F);
}
