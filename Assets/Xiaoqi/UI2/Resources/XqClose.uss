/* P2-3 近景界面样式（G59-P2 §3.2 / P1 §4 玻璃风）。
   放在 UI2/Resources/ 下是为了运行时能 Resources.Load<StyleSheet>("XqClose")，
   不改动已有的 xq.uss。几何量（left/top/width/height/font-size）全部由
   XqClosePanel.Place() 按屏幕尺寸写进 style，不写在这里，避免两处数字打架；
   这里只写颜色、圆角、描边、对齐这些不随分辨率变的部分。 */

.xq-cl-rail {
    position: absolute;
    background-color: rgba(255, 255, 255, 0.78);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.85);
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
}

.xq-cl-dot {
    position: relative;
    border-radius: 999px;
    background-color: rgba(255, 255, 255, 0.88);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.9);
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
    flex-shrink: 0;
}

.xq-cl-dot.on {
    background-color: var(--xq-accent, #FF8FB8);
    border-color: rgba(255, 255, 255, 0.95);
}

.xq-cl-dot.off {
    opacity: 0.45;
}

.xq-cl-dot-word {
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--xq-ink, #3B2F55);
}

.xq-cl-dot.on .xq-cl-dot-word {
    color: rgb(255, 255, 255);
}

.xq-cl-plate {
    position: absolute;
    background-color: rgba(255, 255, 255, 0.78);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.85);
    border-radius: 999px;
    align-items: center;
    justify-content: center;
}

.xq-cl-plate-text {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--xq-ink, #3B2F55);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.xq-cl-btn {
    position: absolute;
    background-color: rgba(255, 255, 255, 0.78);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.85);
    align-items: center;
    justify-content: center;
}

.xq-cl-btn-word {
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--xq-ink, #3B2F55);
    white-space: nowrap;
}

.xq-cl-btn.off {
    background-color: rgba(255, 255, 255, 0.35);
    border-color: rgba(255, 255, 255, 0.55);
    opacity: 0.55;
}

.xq-cl-btn.off .xq-cl-btn-word {
    color: rgba(59, 47, 85, 0.5);
}

.xq-cl-tip {
    position: absolute;
    right: 100%;
    top: 50%;
    margin-right: 8px;
    margin-top: -14px;
    font-size: 15px;
    color: var(--xq-ink, #3B2F55);
    background-color: rgba(255, 255, 255, 0.92);
    border-radius: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    white-space: nowrap;
    display: none;
}

.xq-cl-tip.on {
    display: flex;
}

/* ---------------- 3b：四张卡 + 圆环 ----------------
   几何量（left/top/width/height/font-size/padding/圆角）都由
   XqClosePanel.Place() 按 u 写进 style，这里只放颜色、对齐、结构。 */

.xq-cl-card {
    position: absolute;
}

.xq-cl-card .xq-body {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    overflow: hidden;
}

.xq-cl-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.xq-cl-kicker {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--xq-accent-ink, #D6477F);
    -unity-text-align: upper-left;
    white-space: nowrap;
}

.xq-cl-empty {
    font-size: 15px;
    color: rgba(59, 47, 85, 0.45);
    -unity-text-align: upper-left;
    white-space: normal;
    margin-top: 6px;
}

.xq-cl-text {
    font-size: 15px;
    color: var(--xq-ink, #3B2F55);
    -unity-text-align: upper-left;
    white-space: normal;
}

.xq-cl-big {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--xq-ink, #3B2F55);
    -unity-text-align: upper-left;
    white-space: nowrap;
    margin-top: 4px;
}

.xq-cl-row-left {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
}

.xq-cl-arc {
    margin-right: 10px;
}

/* ④ 她说卡正文：整句完整显示，不截断 */
.xq-cl-say-text {
    font-size: 15px;
    color: var(--xq-ink, #3B2F55);
    white-space: normal;
    -unity-text-align: upper-left;
    flex-grow: 1;
}

.xq-cl-mark {
    font-size: 14px;
    color: rgba(59, 47, 85, 0.5);
    background-color: rgba(255, 255, 255, 0.85);
    border-radius: 8px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 6px;
    padding-right: 6px;
    white-space: nowrap;
    flex-shrink: 0;
}

/* ⑤ 小折线：高度由布局给，宽度撑满 */
.xq-cl-spark {
    height: 30px;
    margin-top: 8px;
    margin-bottom: 6px;
}

.xq-cl-ring {
    position: absolute;
    align-items: center;
    justify-content: center;
}

.xq-cl-ring-word {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgba(59, 47, 85, 0.55);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

